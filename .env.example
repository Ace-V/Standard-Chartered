# ==============================================================================
# CreditRisk Analytics — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values for your local environment.
# NEVER commit the actual '.env' file or production credentials to version control.

# Database Storage Connection URL
# SQLite (Local file storage default):
CREDIT_RISK_DB_URL=sqlite:///data/credit_risk.db

# PostgreSQL (Enterprise deployment example):
# CREDIT_RISK_DB_URL=postgresql+psycopg2://risk_admin:SecurePassword123!@localhost:5432/credit_risk_db

# Logging & Observability
CREDIT_RISK_LOG_LEVEL=INFO

# Application Security & Execution Mode
CREDIT_RISK_ENV=development
CREDIT_RISK_RANDOM_SEED=42
